## Original defaults saved as config.default

[general]
framerate = 60
autosens = 1
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = noncurses
channels = stereo
mono_option = average

[color]
## Matches Hyprland/Alacritty/Waybar palette (slate -> mauve -> amber -> sand)
background = default
gradient = 1
gradient_color_1 = '#6c7f93'
gradient_color_2 = '#8a99a8'
gradient_color_3 = '#b894af'
gradient_color_4 = '#cc9166'
gradient_color_5 = '#d9ac8c'
[smoothing]
monstercat = 1
noise_reduction = 77
